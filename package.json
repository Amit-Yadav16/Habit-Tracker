{
  "name": "habit-tracker",
  "productName": "Habit Tracker",
  "version": "1.0.0",
  "description": "Monthly habit tracker with reminders and punishments",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.me.habittracker",
    "productName": "Habit Tracker",
    "files": ["main.js", "index.html"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
